+    /// HomeView daemons that declare `temporary-sandbox`, and the lookups its
+    /// cloudOS 26.4 profile denies them that 27.2's allows (each seen failing
+    /// with error 159, "Sandbox restriction"). BreadBoard, the shell, takes
+    /// Campo's backboard/frontboard set; userprofilesd creates the guest
+    /// persona BreadBoard waits for, through UserManager.
+    static let homeViewSandboxLookups: [(path: String, services: [String])] = [
+        ("System/Library/CoreServices/BreadBoard.app/BreadBoard",
+         CustomFirmwareMachLookupExceptions.services + [
+             "com.apple.mobile.keybagd.UserManager.xpc",
+             "com.apple.telephonyutilities.callservicesdaemon.callcapabilities",
+         ]),
+        ("System/Library/PrivateFrameworks/UserProfilesDaemon.framework/Support/userprofilesd",
+         ["com.apple.mobile.keybagd.UserManager.xpc", "com.apple.homed.xpc"]),
+    ]
+
+    /// Adds ``homeViewSandboxLookups`` to each daemon's own mach-lookup
+    /// exceptions. False when the guest has no BreadBoard, which is every TV
+    /// but HomeView.
+    private func patchHomeViewShellLookup(system: VPhoneConfinedDirectory, work: WorkDirectory, backupSafe: Bool) throws -> Bool {
+        var patched = false
+        for (target, services) in Self.homeViewSandboxLookups {
+            let name = (target as NSString).lastPathComponent
+            guard let staged = try stageOptional(target, from: system, work: work, label: name) else { continue }
+            guard let source = try VPhoneSigner.entitlements(ofFileAt: staged).first(where: { !$0.isEmpty }) else {
+                throw ValidationError("\(name) has no readable entitlements")
+            }
+            let ent = work.file("\(name).entitlements")
+            try source.write(to: ent)
+            try CustomFirmwareMachLookupExceptions.merge(at: ent, services: services)
+            try backupEntitlementTarget(target, in: system, backupSafe: backupSafe)
+            try VPhoneSigner.sign(
+                fileAt: staged,
+                options: .init(entitlements: Data(contentsOf: ent), style: .appleAdHoc),
+            )
+            try system.replaceFile(target, fromFileAt: staged, mode: 0o755, owner: Self.guestOwner)
+            patched = true
+        }
+        return patched
+    }
